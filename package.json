{
  "name": "agent-weave",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "pnpm --filter @agent-weave/contracts build",
    "dev": "pnpm --parallel --filter @agent-weave/web --filter @agent-weave/server dev",
    "dev:web": "pnpm --filter @agent-weave/web dev",
    "dev:server": "pnpm --filter @agent-weave/contracts build && pnpm --filter @agent-weave/server dev",
    "dev:desktop": "pnpm --filter @agent-weave/desktop dev",
    "desktop:pack": "pnpm --filter @agent-weave/desktop run pack",
    "desktop:dist:mac": "pnpm --filter @agent-weave/desktop run dist:mac",
    "desktop:dist:win": "pnpm --filter @agent-weave/desktop run dist:win",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @agent-weave/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @agent-weave/contracts build && pnpm -r test"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
